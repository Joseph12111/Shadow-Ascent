# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# OpenAI - server-only Supabase Edge Function secrets
# Never prefix these with VITE_ or expose them in Vercel's frontend environment.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# App owner/admin
VITE_OWNER_EMAIL=owner@example.com

# Stripe
# Publishable keys are safe in a browser, but the current Stripe Payment Links do not require this value.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Optional: paste your Stripe-hosted customer portal or customer login URL here.
# Do not put Stripe secret keys in Vite env variables.
VITE_STRIPE_CUSTOMER_PORTAL_URL=your_stripe_customer_portal_url_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
