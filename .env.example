# Vercel frontend variables
# These VITE_ values are public and are included in the browser bundle.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_OWNER_EMAIL=owner@example.com

# Vercel server-only variables
# Never prefix these values with VITE_. They are read only by files in /api and /server.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server routing
APP_URL=your_production_app_url_here
OWNER_EMAIL=owner@example.com
